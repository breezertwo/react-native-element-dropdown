{
  "name": "@breezertwo/react-native-element-dropdown",
  "version": "2.13.1",
  "description": "React Native Element Dropdown is a library that provides a customizable dropdown component for React Native applications.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepack": "bob build",
    "release": "release-it",
    "example": "pnpm --filter example"
  },
  "packageManager": "pnpm@12.23.0",
  "keywords": [
    "react-native",
    "elements",
    "components",
    "material",
    "dropdown",
    "lazy loading",
    "load more",
    "menu",
    "multiselect",
    "picker",
    "select"
  ],
  "repository": "https://github.com/breezertwo/react-native-element-dropdown",
  "author": "Andy <andy@heycare.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/breezertwo/react-native-element-dropdown/issues"
  },
  "homepage": "https://github.com/breezertwo/react-native-element-dropdown#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@jest/globals": "^30.5.2",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/lodash": "^4.17.20",
    "@types/react": "~19.3.0",
    "@volksverpetzer/eslint-plugin-react-native-a11y": "3.6.0",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "release-it": "^21.1.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-native": ">=0.83.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/)?((jest-)?react-native|@react-native(-community)?)[/+@])"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "helpUrl": "https://github.com/breezertwo/react-native-element-dropdown/blob/main/CONTRIBUTING.md#commit-message-convention"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
